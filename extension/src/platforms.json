[
  {
    "id": "wb-stream",
    "name": "WB Stream",
    "hosts": ["stream.wb.ru"],
    "callPath": "/room/",
    "capabilities": {
      "audio": "per-participant"
    }
  },
  {
    "id": "telemost",
    "name": "Яндекс Телемост",
    "hosts": ["telemost.yandex.ru"],
    "callPath": "/j/",
    "capabilities": {
      "audio": "mixed"
    }
  },
  {
    "id": "google-meet",
    "name": "Google Meet",
    "hosts": ["meet.google.com"],
    "callPathPattern": "^/[a-z]{3}-[a-z]{4}-[a-z]{3}/?$",
    "capabilities": {
      "audio": "slots",
      "localAudio": "sender"
    }
  }
]
