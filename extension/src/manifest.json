{
  "manifest_version": 3,
  "name": "Rechiv",
  "version": "0.4.1",
  "key": "",
  "description": "Локальная запись, транскрибация и анализ созвонов",
  "permissions": ["tabs", "notifications", "storage", "alarms"],
  "host_permissions": [],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [],
      "js": ["content/injector.js", "content/dom-parser.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [],
      "js": ["content/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content/presence.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-default-16.png",
      "48": "icons/icon-default-48.png",
      "128": "icons/icon-default-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-default-16.png",
    "48": "icons/icon-default-48.png",
    "128": "icons/icon-default-128.png"
  }
}
