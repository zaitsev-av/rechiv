{
  "name": "rechiv-extension",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:web": "tsc --noEmit && node scripts/build-web.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tests",
    "lint": "biome check src/ tests/ && npm run typecheck",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "chrome-types": "^0.1.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.2.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4"
  }
}
